# ══════════════════════════════════════════════════════════════
#  BACKEND — Variables de entorno (template)
# ══════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Base de datos (rellenar según tu driver) ──────────────────
# Ejemplos:
#   MySQL:      DB_HOST, DB_PORT, DB_USER, DB_PASS, DB_NAME
#   Postgres:   DATABASE_URL=postgres://user:pass@host:5432/db
#   Mongo:      MONGODB_URI=mongodb://localhost:27017/mydb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=change_me
DB_PASS=change_me
DB_NAME=change_me

# ── JWT ───────────────────────────────────────────────────────
# Generá un secreto largo:  openssl rand -hex 64
JWT_SECRET=reemplaza_con_un_secreto_muy_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ── Cookies ───────────────────────────────────────────────────
COOKIE_SECRET=otro_secreto_diferente_para_cookies

# ── CORS ──────────────────────────────────────────────────────
# Lista separada por comas (sin trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ── URLs públicas (para MercadoPago) ──────────────────────────
PUBLIC_URL=http://localhost:5173
PUBLIC_API_URL=

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# ── MercadoPago ───────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_CURRENCY=ARS
MP_STATEMENT_DESCRIPTOR=MI_TIENDA

# ── Uploads ───────────────────────────────────────────────────
UPLOADS_DIR=uploads
