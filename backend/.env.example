# ══════════════════════════════════════════════════════════════
#  BACKEND — Variables de entorno
#  Copiá este archivo como .env y completá los valores reales
#  NUNCA subas el .env al repositorio
# ══════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MySQL ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=zolimportados_user
DB_PASS=password_seguro_aqui
DB_NAME=zolimportados_db

# ── JWT ───────────────────────────────────────────────────────
# Generá un secreto largo:  openssl rand -hex 64
JWT_SECRET=reemplaza_con_un_secreto_muy_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ── Cookies ───────────────────────────────────────────────────
# Otro secreto diferente:   openssl rand -hex 32
COOKIE_SECRET=otro_secreto_diferente_para_cookies

# ── CORS ──────────────────────────────────────────────────────
# Orígenes permitidos (lista separada por comas, sin trailing slash).
# Dev:  http://localhost:5173
# Prod: https://zolimportados.com,https://www.zolimportados.com
CLIENT_ORIGIN=https://tudominio.com

# ── URLs públicas (para MercadoPago back_urls + webhook) ─────
# PUBLIC_URL: URL canónica del frontend para construir back_urls de MP.
#   Si no se setea, se usa el PRIMER origin de CLIENT_ORIGIN.
# PUBLIC_API_URL: URL pública del backend (donde MP llega al webhook).
#   En dev local dejar vacío (MP no puede llegar a localhost).
#   En prod: https://api.tudominio.com
PUBLIC_URL=https://tudominio.com
PUBLIC_API_URL=https://api.tudominio.com

# ── Google OAuth ──────────────────────────────────────────────
# Credenciales OAuth 2.0 generadas en Google Cloud Console.
# La callback URL debe estar AUTORIZADA en Google Console (en
# "Authorized redirect URIs" del cliente OAuth):
#   Dev:  http://localhost:5001/api/auth/google/callback
#   Prod: https://api.zolimportados.com/api/auth/google/callback
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
OAUTH_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# ── MercadoPago ───────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-xxxx-xxxx-xxxx-xxxx
MP_PUBLIC_KEY=APP_USR-xxxx-xxxx-xxxx-xxxx
MP_CURRENCY=ARS
MP_STATEMENT_DESCRIPTOR=ZOLIMPORTADOS

# ── Uploads ───────────────────────────────────────────────────
UPLOADS_DIR=uploads
