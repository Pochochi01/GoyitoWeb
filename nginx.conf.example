# ══════════════════════════════════════════════════════════════
#  Nginx — Configuración de producción para ZolImportados
#  Archivo de referencia: copiar a /etc/nginx/sites-available/zolimportados
#  y crear symlink en /etc/nginx/sites-enabled/
#
#  Reemplazá tudominio.com por tu dominio real en todos lados
# ══════════════════════════════════════════════════════════════

server {
    listen 80;
    server_name tudominio.com www.tudominio.com;

    # ── Frontend (React build) ─────────────────────────────────
    root /var/www/zolimportados/frontend/dist;
    index index.html;

    # React Router: todas las rutas sirven index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── API Backend (proxy a Node.js en puerto 5000) ───────────
    location /api/ {
        proxy_pass         http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }

    # ── Uploads (archivos subidos) ─────────────────────────────
    location /uploads/ {
        proxy_pass http://127.0.0.1:5000/uploads/;
    }

    # ── Seguridad ──────────────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";

    # ── Gzip ──────────────────────────────────────────────────
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1000;

    # ── Cache para assets estáticos ────────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ── Logs ──────────────────────────────────────────────────
    access_log /var/log/nginx/zolimportados-access.log;
    error_log  /var/log/nginx/zolimportados-error.log;
}

# ── HTTPS (Certbot lo completa automáticamente) ────────────────
# Certbot agrega aquí el bloque SSL al correr:
#   sudo certbot --nginx -d tudominio.com -d www.tudominio.com
